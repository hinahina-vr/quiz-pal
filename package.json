{
  "name": "quiz-pal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run prepare:contest",
    "build:portable:html": "tsc -b && node scripts/build-portable-html.mjs",
    "preview": "node scripts/preview-contest.mjs",
